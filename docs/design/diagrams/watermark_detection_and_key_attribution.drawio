  <diagram id="detection-attribution" name="Watermark Presence And Key Attribution">
    <mxGraphModel dx="1800" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Watermark Presence And Key Attribution Decision (planned blind detection; not payload decoding)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="runtime_verified / implemented; frozen SD3.5 runtime qualification passed. Content score remains the only positive authority; no LF/routing promotion, FPR, robustness, or formal evidence." style="text;html=1;fontSize=12;align=left;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;Formal inputs&lt;/b&gt;&lt;br&gt;ordinary RGB + detection key&lt;br&gt;frozen public model/assets&lt;br&gt;content config + tau identity&lt;br&gt;no reference or embed state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="290" height="180" as="geometry"/></mxCell>
        <mxCell id="pre" value="&lt;b&gt;Shared preprocess (planned)&lt;/b&gt;&lt;br&gt;ordinary RGB preprocess&lt;br&gt;VAE posterior mode&lt;br&gt;same model/revision/dtype&lt;br&gt;key-only template reconstruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="380" y="145" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="lf" value="&lt;b&gt;LF blind detector (planned)&lt;/b&gt;&lt;br&gt;independent template + score&lt;br&gt;output s_lf / failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="740" y="125" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="hf" value="&lt;b&gt;HF blind detector (planned)&lt;/b&gt;&lt;br&gt;HF direct score&lt;br&gt;output s_hf / failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="740" y="310" width="240" height="145" as="geometry"/></mxCell>
        <mxCell id="detector" value="&lt;b&gt;Same content detector (planned)&lt;/b&gt;&lt;br&gt;s_lf + s_hf independently observable&lt;br&gt;s_combined only after promotion&lt;br&gt;current D_M remains HF-only&lt;br&gt;same key/preprocess/config/tau&lt;br&gt;raw score + margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1040" y="180" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="positive" value="&lt;b&gt;Raw content positive&lt;/b&gt;&lt;br&gt;score ≥ tau → final positive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="145" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="far" value="&lt;b&gt;Far negative&lt;/b&gt;&lt;br&gt;outside rescue → final negative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="300" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="near" value="&lt;b&gt;Near-threshold gate (planned)&lt;/b&gt;&lt;br&gt;score &lt; tau and margin in frozen window&lt;br&gt;only this branch may call geometry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="340" height="135" as="geometry"/></mxCell>
        <mxCell id="qk" value="&lt;b&gt;Blind Q/K observation (planned)&lt;/b&gt;&lt;br&gt;same RGB + key + public assets&lt;br&gt;image-only empty-condition forward&lt;br&gt;no generation cache / true attack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="est" value="&lt;b&gt;Transform estimator (planned)&lt;/b&gt;&lt;br&gt;bounded crop/scale/rotation/shift&lt;br&gt;raw score/gap/residual/coverage&lt;br&gt;does not decide reliability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="330" y="540" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="rel" value="&lt;b&gt;Independent reliability conjunction&lt;/b&gt;&lt;br&gt;wrong-key + coverage + uniqueness + gap&lt;br&gt;residual + finite + interior&lt;br&gt;all pass; never content positive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="geofail" value="&lt;b&gt;Geometry fail closed&lt;/b&gt;&lt;br&gt;wrong key / unreliable / invalid&lt;br&gt;→ preserve raw negative" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="rect" value="&lt;b&gt;Image rectifier (planned)&lt;/b&gt;&lt;br&gt;reliable estimate only&lt;br&gt;inverse warp + valid support&lt;br&gt;ordinary rectified RGB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="820" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="same" value="&lt;b&gt;Exact same detector re-entry&lt;/b&gt;&lt;br&gt;same preprocess / LF-HF detectors / content detector&lt;br&gt;same key semantics / config / tau&lt;br&gt;no rectified-only classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="740" y="800" width="410" height="180" as="geometry"/></mxCell>
        <mxCell id="rectdecision" value="&lt;b&gt;Rectified content decision&lt;/b&gt;&lt;br&gt;score ≥ same tau → positive&lt;br&gt;else final negative&lt;br&gt;geometry cannot add score&lt;br&gt;wrong-key failure stays closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="800" width="490" height="180" as="geometry"/></mxCell>
        <mxCell id="boundary" value="&lt;b&gt;Blind boundary / failure propagation&lt;/b&gt;&lt;br&gt;Forbidden: reference image, embed record, private latent statistics, generation Q/K cache, oracle attack parameters.&lt;br&gt;Only raw or rectified content score crossing the same tau may produce positive; all failures stay observable and in denominator.&lt;br&gt;CPU/synthetic method behavior recorded—not runtime or scientific evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1700" height="140" as="geometry"/></mxCell>
