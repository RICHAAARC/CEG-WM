<mxfile host="app.diagrams.net" modified="2026-07-27T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="paper-evidence" name="Paper Evidence Production">
    <mxGraphModel dx="1900" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Paper Evidence Production (planned governed evidence chain)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Guide only: method_construction_authorized / not_implemented; 13 components + 27 CPU/synthetic readiness nodes recorded; independent stage transition pending. No runtime/GPU/FPR/formal evidence." style="text;html=1;fontSize=12;align=left;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="method" value="&lt;b&gt;Frozen method identity&lt;/b&gt;&lt;br&gt;method/config digest&lt;br&gt;repository + model revision&lt;br&gt;detector/key/threshold identity&lt;br&gt;no formal-evaluation drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;Preregistered data / samples / mutually exclusive roles&lt;/b&gt;&lt;br&gt;sample + split + attack manifests; prompt/seed/key clusters&lt;br&gt;1 candidate-selection (selection + untouched confirmation)&lt;br&gt;2 content-threshold-fit · 3 rescue-window-fit&lt;br&gt;4 geometry-reliability-fit · 5 end-to-end calibration check&lt;br&gt;formal evaluation is disjoint and never selects candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="internal" value="&lt;b&gt;Internal candidate validation&lt;/b&gt;&lt;br&gt;LF/HF/routing/combination&lt;br&gt;QK/estimator/reliability/rescue&lt;br&gt;promotion or honest negative closure&lt;br&gt;separate from external comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="140" width="400" height="180" as="geometry"/></mxCell>
        <mxCell id="external" value="&lt;b&gt;External comparison registration&lt;/b&gt;&lt;br&gt;immutable baseline source + revision/archive digest&lt;br&gt;license/reuse authorization&lt;br&gt;adapter + config + deviation record&lt;br&gt;shared samples/budget/attacks/metrics&lt;br&gt;rights/source gap fails admission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1440" y="140" width="410" height="250" as="geometry"/></mxCell>
        <mxCell id="preflight" value="&lt;b&gt;Protocol preflight&lt;/b&gt;&lt;br&gt;freeze method + split roles + baseline identities + adapters&lt;br&gt;verify fair samples, total budget, attack order, metrics, failure denominator and FPR definition&lt;br&gt;leakage / rights / identity / input failure → stop before high-cost run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="455" width="800" height="130" as="geometry"/></mxCell>
        <mxCell id="runner" value="&lt;b&gt;Unique governed runner&lt;/b&gt;&lt;br&gt;only composition surface for method + baseline + attacks + metrics&lt;br&gt;writes governed records; no hand-edited result channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="650" y="640" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="records" value="&lt;b&gt;Governed records: full denominator&lt;/b&gt;&lt;br&gt;success · failure · exclusion&lt;br&gt;raw/rectified scores + attacks + metrics&lt;br&gt;resource failure; no silent retry/drop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="825" width="430" height="180" as="geometry"/></mxCell>
        <mxCell id="prov" value="&lt;b&gt;Provenance&lt;/b&gt;&lt;br&gt;method/model/source revisions&lt;br&gt;sample/split/config digests&lt;br&gt;baseline license + deviation&lt;br&gt;runner/environment identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="520" y="825" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="manifest" value="&lt;b&gt;Frozen manifest&lt;/b&gt;&lt;br&gt;records + digests&lt;br&gt;config_digest + code_version&lt;br&gt;artifact inputs/outputs&lt;br&gt;rebuild command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="825" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;paper_artifacts rebuild only&lt;/b&gt;&lt;br&gt;consume frozen records + manifests&lt;br&gt;rebuild tables / figures / reports&lt;br&gt;must not rerun method / attack / baseline&lt;br&gt;must not read audit/log/notebook as facts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1320" y="825" width="530" height="180" as="geometry"/></mxCell>
        <mxCell id="claims" value="&lt;b&gt;Claim audit&lt;/b&gt;&lt;br&gt;claim → artifact → manifest&lt;br&gt;→ governed source records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1320" y="1050" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="packages" value="&lt;b&gt;Three release packages&lt;/b&gt;&lt;br&gt;minimal method&lt;br&gt;experiment execution&lt;br&gt;paper artifact rebuild&lt;br&gt;extraction profiles govern contents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="1600" y="1050" width="250" height="170" as="geometry"/></mxCell>
        <mxCell id="notfacts" value="&lt;b&gt;Not scientific evidence&lt;/b&gt;&lt;br&gt;tests · governance audits · audit_reports · logs · Notebook outputs · directory presence · documentation · screenshots&lt;br&gt;These can verify process/software behavior but cannot support claims without governed records + frozen manifests.&lt;br&gt;paper_artifacts is rebuild-only; unsupported claims remain unsupported." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#b91c1c;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1180" height="160" as="geometry"/></mxCell>
