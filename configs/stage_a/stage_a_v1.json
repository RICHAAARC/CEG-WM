{
  "protocol_id": "cegwm-stage-a-v1",
  "protocol_version": 1,
  "scientific_question": "Can HF reproduce blind keyed attribution, and can an independent LF carrier add non-geometric attack complementarity without becoming a generic image-content signal?",
  "scope_exclusions": [
    "adaptive_routing",
    "lf_hf_fusion",
    "crop_oracle",
    "qk_geometry",
    "joint_recovery",
    "fixed_fpr_formal_evaluation",
    "paper_results"
  ],
  "detection_access": {
    "allowed_inputs": [
      "image",
      "detection_key",
      "frozen_public_assets"
    ],
    "forbidden_inputs": [
      "original_image",
      "prompt",
      "embed_record",
      "private_latent",
      "embedding_latent",
      "embed_side_route",
      "route",
      "mask",
      "cached_qk",
      "qk"
    ],
    "threshold_status": "deferred_calibration_not_stage_a"
  },
  "generation_runtime": {
    "model_id": "stabilityai/stable-diffusion-3.5-medium",
    "scheduler_family": "FlowMatchEulerDiscreteScheduler",
    "inference_steps": 20,
    "image_dtype": "float32_rgb_0_1",
    "latent_dtype": "runtime_actual_dtype",
    "public_asset_rule": "protocol_model_id_default_hub_resolution_without_revision_or_weight_digest",
    "asset_reuse_rule": "reuse_the_same_loaded_model_instance_across_all_units_and_both_splits"
  },
  "keying": {
    "task": "zero_bit_keyed_attribution",
    "normalization": "NFC_UTF8_for_text_exact_bytes_for_binary",
    "prg": "HMAC_SHA256_counter_v1",
    "wrong_key_count": 16,
    "wrong_key_derivation_domain": "stage-a/external-wrong-key/v1",
    "primary_null": true,
    "payload_bits": 0
  },
  "bands": {
    "radius_definition": "rfft2_radial_frequency_divided_by_2d_nyquist_corner",
    "lf_radius": [
      0.04,
      0.24
    ],
    "hf_radius": [
      0.58,
      1.0
    ]
  },
  "budget": {
    "total_relative_l2": 0.012,
    "measurement": "actual_dtype_final_minus_actual_dtype_base",
    "shared_across_active_carriers": true,
    "quality_metrics": [
      "rgb_psnr",
      "lpips_alex"
    ],
    "quality_limits": {
      "rgb_psnr_min_db": 30.0,
      "lpips_alex_max": 0.12
    }
  },
  "hf_anchor": {
    "candidate_id": "hf_tail_rademacher_v1",
    "injection_step_index_zero_based": 18,
    "carrier": "keyed_rademacher_on_hf_rfft_band",
    "blind_score": "vae_reencode_hf_masked_normalized_correlation",
    "uses_lf": false
  },
  "lf_candidates": [
    {
      "candidate_id": "lf_core_rademacher_v1",
      "injection_step_index_zero_based": 18,
      "carrier": "keyed_rademacher_on_lf_rfft_band",
      "blind_score": "vae_reencode_lf_masked_normalized_correlation",
      "radial_subband": [
        0.04,
        0.14
      ],
      "uses_hf": false
    },
    {
      "candidate_id": "lf_shell_rademacher_v1",
      "injection_step_index_zero_based": 18,
      "carrier": "keyed_rademacher_on_lf_rfft_band",
      "blind_score": "vae_reencode_lf_masked_normalized_correlation",
      "radial_subband": [
        0.14,
        0.24
      ],
      "uses_hf": false
    }
  ],
  "attacks": [
    {
      "attack_id": "identity",
      "kind": "clean"
    },
    {
      "attack_id": "jpeg_q75",
      "kind": "non_geometric",
      "jpeg_quality": 75
    },
    {
      "attack_id": "gaussian_blur_sigma_1",
      "kind": "non_geometric",
      "sigma_pixels": 1.0
    },
    {
      "attack_id": "gaussian_noise_std_0_01",
      "kind": "non_geometric",
      "rgb_0_1_std": 0.01
    }
  ],
  "controls": {
    "correct_key": "registered_detection_key",
    "wrong_key": "16_external_domain_separated_keys",
    "primary_null": "same_generation_units_without_embedding",
    "report_wrong_key_and_primary_null_separately": true
  },
  "selection_rule": {
    "clean_gate": {
      "applies_to": [
        "hf_anchor",
        "each_lf_candidate"
      ],
      "correct_score_gt_wrong_key_max_min_units": 7,
      "fixed_units": 8,
      "median_correct_minus_wrong_key_max_min": 0.1,
      "primary_null_abs_score_p95_max": 0.2,
      "quality_limits_apply_to_min_units": 7
    },
    "attack_complementarity_gate": {
      "prerequisite": "clean_gate_pass",
      "correct_score_gt_wrong_key_max_min_units_per_attack": 7,
      "fixed_units_per_attack": 8,
      "lf_minus_hf_median_score_retention_min_on_at_least_one_attack": 0.1
    },
    "ranking": "maximize_minimum_non_geometric_correct_minus_wrong_key_max_margin_then_clean_margin",
    "ties": "higher_median_rgb_psnr_then_lexical_candidate_id"
  },
  "confirmation_rule": {
    "candidate": "single_frozen_selection_winner",
    "arms": [
      "hf_anchor",
      "frozen_lf_winner",
      "primary_null"
    ],
    "correct_score_gt_wrong_key_max_min_units": 7,
    "fixed_units": 8,
    "median_correct_minus_wrong_key_max_min": 0.1,
    "primary_null_abs_score_p95_max": 0.2,
    "quality_limits_apply_to_min_units": 7,
    "recheck_all_preregistered_attacks": true,
    "score_retention_definition": "attacked_correct_minus_wrong_key_max_divided_by_clean_correct_minus_wrong_key_max",
    "lf_minus_hf_median_score_retention_min_on_at_least_one_attack": 0.1,
    "failure_outcome": "SCIENTIFIC_NEGATIVE_AND_STOP"
  },
  "execution_flow": {
    "candidate_selection_manifest": "candidate_selection.jsonl",
    "candidate_selection_units": 8,
    "untouched_confirmation_manifest": "untouched_confirmation.jsonl",
    "untouched_confirmation_units": 8,
    "attack_evaluation_requires_clean_lf_pass": true,
    "confirmation_requires_frozen_candidate": true,
    "failure_units_remain_in_denominator": true,
    "replacement_units_allowed": false,
    "operational_failure_counts_as_pass": false,
    "excluded_unit_requires_predeclared_outcome_independent_reason": true,
    "stop_if_hf_anchor_fails": true,
    "stop_if_all_lf_clean_gates_fail": true,
    "stop_if_confirmation_fails": true
  }
}
